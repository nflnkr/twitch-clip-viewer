{
    "name": "twitch-clip-viewer",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.10.0",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "turbo run dev",
        "preview": "turbo run preview",
        "build": "turbo run build",
        "clean": "git clean -xdf node_modules",
        "clean:ws": "turbo run clean",
        "format": "prettier --write \"**/*.{ts,tsx,md}\" --list-different",
        "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache --max-warnings 0",
        "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
        "lint:ws": "pnpm dlx sherif@latest --no-install --fix --select highest",
        "fix": "pnpm run lint:fix && pnpm run format",
        "typecheck": "turbo run typecheck",
        "postinstall": "pnpm lint:ws"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
        "dotenv-cli": "^11.0.0",
        "prettier": "^3.5.3",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "turbo": "^2.5.0",
        "typescript": "^5.7.2"
    },
    "prettier": {
        "printWidth": 100,
        "singleAttributePerLine": true,
        "tabWidth": 4,
        "plugins": [
            "@ianvs/prettier-plugin-sort-imports",
            "prettier-plugin-tailwindcss"
        ],
        "tailwindFunctions": [
            "cn",
            "cva"
        ],
        "importOrder": [
            "<BUILTIN_MODULES>",
            "<THIRD_PARTY_MODULES>",
            "",
            "^@repo/",
            "",
            "^#",
            "",
            "^~",
            "",
            "^[./]"
        ]
    }
}
