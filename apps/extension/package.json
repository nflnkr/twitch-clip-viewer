{
    "name": "ttv-clip-viewer",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm with-env vite --host",
        "build": "pnpm with-env vite build",
        "clean": "git clean -xdf .turbo node_modules .cache dist",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint . --ext ts,tsx --fix",
        "explore-source-map": "npx source-map-explorer dist/assets/\\*.js --no-border-checks",
        "with-env": "dotenv -e ../../.env --"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^7.3.11",
        "@mui/material": "^7.3.11",
        "@orpc/client": "^1.15.0",
        "@orpc/server": "^1.15.0",
        "@orpc/tanstack-query": "^1.15.0",
        "@repo/api": "workspace:*",
        "@t3-oss/env-core": "^0.13.8",
        "@tanstack/react-devtools": "^0.7.0",
        "@tanstack/react-query": "^5.66.5",
        "@tanstack/react-query-devtools": "^5.84.2",
        "@tanstack/react-virtual": "^3.13.13",
        "date-fns": "^4.1.0",
        "fuzzysort": "^3.1.0",
        "react": "^19.2.8",
        "react-day-picker": "^9.12.0",
        "react-dom": "^19.2.8",
        "react-error-boundary": "^4.1.2",
        "react-rnd": "^10.5.3",
        "zod": "^4.4.3",
        "zustand": "^4.5.5"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@crxjs/vite-plugin": "2.4.0",
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tanstack/devtools-vite": "^0.3.11",
        "@types/babel__core": "^7.20.5",
        "@types/chrome": "^0.1.42",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.1.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.2",
        "typescript": "~6.0.2",
        "vite": "^8.2.2"
    }
}
